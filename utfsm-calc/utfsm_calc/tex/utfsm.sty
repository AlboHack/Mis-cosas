\RequirePackage[utf8]{inputenc}
\ifutfsm@coma
  \RequirePackage[spanish,es-noshorthands,es-tabla]{babel}
\else
  \RequirePackage[spanish,es-noshorthands,es-nodecimaldot,es-tabla]{babel}
\fi
\RequirePackage{lmodern}
\RequirePackage[letterpaper,margin=2.5cm,top=3.2cm,headheight=1.4cm,headsep=0.6cm]{geometry}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{graphicx,xcolor}
\RequirePackage{booktabs,array,tabularx,longtable}
\RequirePackage{siunitx}
\sisetup{group-separator={\,},group-minimum-digits=5,per-mode=symbol}
\ifutfsm@coma\sisetup{output-decimal-marker={,}}\fi
\DeclareSIUnit\tonf{Tonf}
\RequirePackage{fancyhdr,enumitem,caption,float,adjustbox,eso-pic}
\RequirePackage{needspace,etoolbox}
\RequirePackage[section]{placeins}
\RequirePackage[most]{tcolorbox}
\RequirePackage{tikz,pgfplots}
\pgfplotsset{compat=1.18}
\usetikzlibrary{arrows.meta,patterns,decorations.pathmorphing,calc,angles,quotes,positioning,babel}
\ifutfsm@stanli\RequirePackage{stanli}\fi
\RequirePackage[hidelinks]{hyperref}
\graphicspath{{img/}{./}}
