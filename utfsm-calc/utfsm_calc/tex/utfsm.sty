% utfsm.sty -- formato de la casa para informes, guías y apuntes (Nicolás Albornoz, Obras Civiles UTFSM).
% Lo copia `python -m utfsm_calc.plantilla`; se entrega junto al .tex (Collab Text no lo trae).
% Opciones: particular (clases particulares: sin logos, coma decimal, marca de agua de texto),
%           coma (coma decimal), sinmarca (sin marca de agua), stanli (carga la librería stanli).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{utfsm}[2026/11/16 v1.0 Formato UTFSM Obras Civiles]

\newif\ifutfsm@particular \newif\ifutfsm@coma \newif\ifutfsm@stanli
\newif\ifutfsm@marca \utfsm@marcatrue
\DeclareOption{particular}{\utfsm@particulartrue\utfsm@comatrue}
\DeclareOption{coma}{\utfsm@comatrue}
\DeclareOption{sinmarca}{\utfsm@marcafalse}
\DeclareOption{stanli}{\utfsm@stanlitrue}
\ProcessOptions\relax

% ---------- Base ----------
