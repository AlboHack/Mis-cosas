% ---------- TikZ: estilos y macros de la casa ----------
\newcommand{\utfsmR}{1.5cm}    % largo de las flechas de un DCL
\newcommand{\utfsmRin}{2.5mm}  % separación entre el nudo y el inicio de la flecha
\tikzset{
  barra/.style={line width=1.4pt,line cap=round,line join=round},
  eje/.style={thin,dash dot,usmgris},
  carga/.style={-{Stealth[length=2.2mm]},usmrojo,thick},
  reaccion/.style={-{Stealth[length=2.2mm]},usmverde,thick},
  interna/.style={-{Stealth[length=2.2mm]},usmazul,thick},
  cotalinea/.style={{Stealth[length=1.6mm]}-{Stealth[length=1.6mm]},thin},
  etq/.style={font=\footnotesize,inner sep=1.5pt},
  nudo/.style={circle,fill,inner sep=0pt,minimum size=3.5pt},
  rotula/.style={circle,draw,fill=white,inner sep=0pt,minimum size=5pt,line width=0.8pt},
  % Apoyos: \pic[rotate=..] at (A) {apoyo fijo};  el punto de apoyo es el origen del pic.
  apoyo fijo/.pic={\draw[thick,fill=white] (0,0)--(-0.22,-0.34)--(0.22,-0.34)--cycle;
    \fill[pattern=north east lines] (-0.34,-0.46) rectangle (0.34,-0.34);\draw[thick] (-0.34,-0.34)--(0.34,-0.34);},
  apoyo movil/.pic={\draw[thick,fill=white] (0,0)--(-0.22,-0.30)--(0.22,-0.30)--cycle;
    \draw[thick,fill=white] (-0.12,-0.36) circle (0.06) (0.12,-0.36) circle (0.06);
    \fill[pattern=north east lines] (-0.34,-0.54) rectangle (0.34,-0.42);\draw[thick] (-0.34,-0.42)--(0.34,-0.42);},
  empotrado/.pic={\fill[pattern=north east lines] (-0.4,-0.14) rectangle (0.4,0);\draw[thick] (-0.4,0)--(0.4,0);}
}
% \cota[desplazamiento]{A}{B}{texto}: línea de cota paralela a AB, a la izquierda del sentido A->B
% (desplazamiento negativo: al otro lado). El texto va sobre la línea con fondo blanco.
\newcommand{\cota}[4][-7mm]{%
  \coordinate (utfsm@a) at ($(#2)!#1!90:(#3)$); \coordinate (utfsm@b) at ($(#3)!#1!-90:(#2)$);
  \draw[very thin,usmgris] ($(#2)!0.25!(utfsm@a)$)--($(#2)!1.15!(utfsm@a)$) ($(#3)!0.25!(utfsm@b)$)--($(#3)!1.15!(utfsm@b)$);
  \draw[cotalinea] (utfsm@a)--node[etq,fill=white]{#4}(utfsm@b);}
% \cargadist[alto]{A}{B}{texto}: carga distribuida uniforme sobre AB, a la izquierda del sentido
% A->B (alto negativo: al otro lado). El texto queda por fuera de la carga.
\newcommand{\cargadist}[4][7mm]{%
  \ifdim#1>0pt \def\utfsm@lado{left}\else\def\utfsm@lado{right}\fi
  \coordinate (utfsm@a) at ($(#2)!#1!90:(#3)$); \coordinate (utfsm@b) at ($(#3)!#1!-90:(#2)$);
  \draw[usmrojo,thick] (utfsm@a)--node[etq,auto=\utfsm@lado]{#4}(utfsm@b);
  \foreach \utfsm@t in {0,0.2,0.4,0.6,0.8,1}
    \draw[carga,thin] ($(utfsm@a)!\utfsm@t!(utfsm@b)$)--($(#2)!\utfsm@t!(#3)$);}
% Fuerzas de un DCL: la etiqueta va en el extremo libre de la flecha, con el anchor opuesto al
% nudo, de modo que no pisa la flecha ni las etiquetas vecinas.
%   \fuerzasale[estilo]{nudo}{ángulo}{etiqueta}   flecha que se aleja del nudo
%   \fuerzaentra[estilo]{nudo}{ángulo}{etiqueta}  flecha que llega al nudo desde ese ángulo
% \tramobarra{nudo}{ángulo}: tramo gris de la barra que llega al nudo; va antes de las fuerzas.
\newcommand{\tramobarra}[2]{\draw[line width=3pt,gray!35,line cap=round] (#1)--($(#1)+(#2:0.7*\utfsmR)$);}
\newcommand{\utfsm@anc}[1]{\pgfmathtruncatemacro{\utfsm@op}{mod(round(#1)+180,360)}}
\newcommand{\fuerzasale}[4][interna]{\utfsm@anc{#3}%
  \draw[#1] ($(#2)+(#3:\utfsmRin)$)--($(#2)+(#3:\utfsmR)$) node[etq,anchor=\utfsm@op]{#4};}
\newcommand{\fuerzaentra}[4][carga]{\utfsm@anc{#3}%
  \draw[#1] ($(#2)+(#3:\utfsmR)$) node[etq,anchor=\utfsm@op]{#4}--($(#2)+(#3:\utfsmRin)$);}
% \angulo[radio]{A}{O}{B}{texto}: arco antihorario de OA a OB con el texto fuera del arco.
\newcommand{\angulo}[5][7mm]{\pic[draw,thin,angle radius=#1,angle eccentricity=1.55,pic text={#5},
  pic text options={etq}]{angle=#2--#3--#4};}
% \momento[estilo]{O}{inicio}{fin}{etiqueta}: momento como arco de radio 4.5 mm, etiqueta en la punta.
\newcommand{\momento}[5][carga]{\utfsm@anc{#4}%
  \draw[#1] ($(#2)+(#3:4.5mm)$) arc[start angle=#3,end angle=#4,radius=4.5mm] node[etq,anchor=\utfsm@op]{#5};}

