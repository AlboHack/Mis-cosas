\definecolor{usmazul}{RGB}{0,70,160}
\definecolor{usmrojo}{RGB}{200,25,25}
\definecolor{usmverde}{RGB}{20,120,60}
\definecolor{usmgris}{RGB}{90,90,90}

\newcommand{\EI}{E\!I}
\newcommand{\EA}{E\!A}
\newcommand{\GJ}{G\!J}
\newcommand{\dd}{\,\mathrm{d}}
\newcommand{\gC}{\,^{\circ}\mathrm{C}}
\newcommand{\pend}{\textcolor{red}{\textbf{??}}}
\newcommand{\completar}[1]{\textcolor{red}{[\textit{#1}]}}

% ---------- Compaginación: nada cortado ----------
% Títulos nunca solos al pie, sin viudas ni huérfanas, tablas y figuras fijas dentro de su punto.
\pretocmd{\section}{\needspace{8\baselineskip}}{}{}
\pretocmd{\subsection}{\needspace{6\baselineskip}}{}{}
\pretocmd{\subsubsection}{\needspace{5\baselineskip}}{}{}
\widowpenalty=10000 \clubpenalty=10000 \displaywidowpenalty=10000 \raggedbottom
\floatplacement{figure}{H}
\floatplacement{table}{H}

% Cajas: indivisibles por defecto. Una caja más alta que la página se declara `breakable` a mano.
\tcbset{utfsm/.style={enhanced,unbreakable,colback=white,colframe=#1,coltitle=white,
  fonttitle=\bfseries\small,arc=1.5pt,boxrule=0.6pt,left=6pt,right=6pt,top=4pt,bottom=4pt,
  boxsep=1pt,before skip=8pt,after skip=8pt},utfsm/.default=usmazul}
\newtcolorbox{enunciado}[2][]{utfsm=usmgris,title={Enunciado -- #2},#1}
\newtcolorbox{resultado}[1][]{utfsm=usmverde,colback=usmverde!6,#1}
\newtcolorbox{nota}[1][]{utfsm=usmazul!60,colback=usmazul!5,leftrule=3pt,#1}
\newtcolorbox{cuidado}[1][]{utfsm=usmrojo,colback=usmrojo!4,leftrule=3pt,#1}
\newtcolorbox{caja}[2][]{utfsm,title={#2},#1}
% juntos: bloque invisible que no se parte (pregunta con sus alternativas, texto con su figura).
\newtcolorbox{juntos}[1][]{blanker,unbreakable,before skip=6pt,after skip=6pt,#1}
\newcounter{pregunta}
\newenvironment{pregunta}{\refstepcounter{pregunta}\begin{juntos}\textbf{\thepregunta.}\ }{\end{juntos}}
\newlist{alternativas}{enumerate}{1}
\setlist[alternativas]{label=\textbf{\Alph*)},leftmargin=2.6em,itemsep=3pt,topsep=3pt}

